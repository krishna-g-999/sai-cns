# sssihl_logo.png, and nothing else in assets/ is referenced anywhere.
/assets/sai_net_logo.png
/assets/sai_net_logo_original_green.png

# ---- Paper-authoring tooling: kept on this machine, not on the public repository ----
# These build the manuscript, the reviewer and audit packages and the technical report. They
# produce the paper, not the tool and not its science, and nothing in REPRODUCE.md asks a reader
# to run any of them. Checked before removal: the only imports among them are internal to this
# set (cite.py by the manuscript builders, report_reference_docx.py by technical_report_docx.py),
# so nothing that stays behind depends on anything that goes.
#
# The scientific analyses in the same directory deliberately STAY: build_master_validation.py,
# build_master_inputs_and_external.py, the figures_*/figure_* validation plots, per_endpoint_report.py,
# temporal_diagnosis.py, variance_decomposition.py and worked_example.py are the evidence behind
# the paper rather than the paper itself.
/src/sai_cns/analysis/add_reference_links.py
/src/sai_cns/analysis/build_audit_package.py
/src/sai_cns/analysis/build_manuscript.py
/src/sai_cns/analysis/build_manuscript_condensed.py
/src/sai_cns/analysis/build_manuscript_print_preview.py
/src/sai_cns/analysis/build_manuscript_with_figure.py
/src/sai_cns/analysis/build_model_inventory.py
/src/sai_cns/analysis/build_review_folder.py
